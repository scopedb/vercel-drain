# Required ScopeDB Cloud connection settings
SCOPEDB_ENDPOINT=https://<workspace>.scopedb.cloud
SCOPEDB_API_KEY=sk_live_replace_me

# At least one Drain authentication secret is required:
# - VERCEL_DRAIN_SECRET verifies the x-vercel-signature HMAC-SHA1 header
# - DRAIN_AUTH_TOKEN verifies an Authorization: Bearer <token> header
VERCEL_DRAIN_SECRET=replace_with_vercel_drain_signing_secret
# DRAIN_AUTH_TOKEN=replace_with_custom_bearer_token

# Optional Vercel endpoint verification challenge token (echoed in x-vercel-verify)
# VERCEL_VERIFY_TOKEN=replace_with_vercel_verify_token

# Optional target database, schema, and table (defaults shown)
SCOPEDB_DATABASE=scopedb
SCOPEDB_SCHEMA=public
SCOPEDB_TABLE=vercel_events

# Optional comma-separated allowlist of extra URL query parameter keys to capture under attributes.query
# SCOPEDB_ALLOWED_QUERY_PARAMS=gclid,fbclid

# Optional comma-separated URL path prefixes whose next path segment is redacted to :redacted
# SCOPEDB_REDACT_PATH_PREFIXES=/reset-password,/magic-link
