# Required ScopeDB Cloud connection settings
SCOPEDB_ENDPOINT=https://your-workspace.scopedb.cloud
SCOPEDB_API_KEY=your-scopedb-api-key

# At least one Drain authentication secret is required:
# - VERCEL_DRAIN_SECRET verifies the x-vercel-signature HMAC-SHA1 header
# - DRAIN_AUTH_TOKEN verifies an Authorization: Bearer <token> header
VERCEL_DRAIN_SECRET=your-vercel-drain-signing-secret
# DRAIN_AUTH_TOKEN=your-custom-bearer-token

# Optional Vercel endpoint verification challenge token (echoed in x-vercel-verify)
# VERCEL_VERIFY_TOKEN=your-vercel-verify-token

# Optional target database, schema, and table (defaults shown)
SCOPEDB_DATABASE=scopedb
SCOPEDB_SCHEMA=public
SCOPEDB_TABLE=vercel_events
